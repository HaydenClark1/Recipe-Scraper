# FatSecret REST API — OAuth 1.0 consumer credentials
# Create at https://platform.fatsecret.com/ (no IP allow-listing needed for OAuth 1.0)
FATSECRET_CONSUMER_KEY=your_consumer_key_here
FATSECRET_CONSUMER_SECRET=your_consumer_secret_here

# Neon (PostgreSQL) — https://neon.tech (free tier)
DATABASE_URL="postgresql://user:pass@ep-xxx.region.aws.neon.tech/neondb?sslmode=require"

# Auth — secret used to sign JWT session tokens (use a long random string in production)
JWT_SECRET=change_me_to_a_long_random_string

# Rate limiting (defaults shown)
# Length of the sliding window in milliseconds (60000 = 1 minute)
RATE_WINDOW_MS=60000
# Max requests per window across all endpoints (catch-all)
RATE_GLOBAL_MAX=120
# Max recipe scrapes per window — scraping is slow and hits Puppeteer
RATE_SCRAPE_MAX=10
# Max food searches per window — hits FatSecret or USDA index
RATE_FOOD_SEARCH_MAX=60
# Max nutrition calculations per window — calls FatSecret per ingredient
RATE_NUTRITION_MAX=60
