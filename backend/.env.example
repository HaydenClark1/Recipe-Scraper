# FatSecret REST API — OAuth 1.0 consumer credentials
# Create at https://platform.fatsecret.com/ (no IP allow-listing needed for OAuth 1.0)
FATSECRET_CONSUMER_KEY=your_consumer_key_here
FATSECRET_CONSUMER_SECRET=your_consumer_secret_here

# Neon (PostgreSQL) — https://neon.tech (free tier)
DATABASE_URL="postgresql://user:pass@ep-xxx.region.aws.neon.tech/neondb?sslmode=require"

# Auth — secret used to sign JWT session tokens.
# In production (NODE_ENV=production) the server refuses to start unless this is
# set to a strong value (>=32 chars, not a known default).
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change_me_to_a_long_random_string

# Set to "production" on Render to enable strict startup checks (JWT_SECRET).
NODE_ENV=development

# CORS allowlist — comma-separated origins permitted to call the API.
# Leave empty to allow all origins (dev). In production set your web origin and
# the Capacitor app origin, e.g.: https://app.example.com,capacitor://localhost
ALLOWED_ORIGINS=
