datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Food {
  fdcId       Int     @id
  description String  @db.VarChar(500)
  dataType    String  @db.VarChar(50)
  category    String? @db.VarChar(100)
  calories    Float?
  protein     Float?
  fat         Float?
  carbs       Float?

  @@index([dataType])
}

model User {
  id           Int           @id @default(autoincrement())
  email        String        @unique @db.VarChar(255)
  passwordHash String        @db.VarChar(255)
  createdAt    DateTime      @default(now())
  savedRecipes SavedRecipe[]
}

model SavedRecipe {
  id              Int      @id @default(autoincrement())
  userId          Int
  user            User     @relation(fields: [userId], references: [id])
  title           String   @db.VarChar(500)
  image           String?  @db.VarChar(1000)
  ingredients     String
  instructions    String
  servings        String?  @db.VarChar(50)
  prepTime        String?  @db.VarChar(100)
  totalTime       String?  @db.VarChar(100)
  category        String?  @db.VarChar(500)
  cuisine         String?  @db.VarChar(500)
  sourceUrl       String?  @db.VarChar(1000)
  createdAt       DateTime @default(now())
  ingredientsData     String?
  nutrition           String?
  nutritionSig        String?
  originalIngredients String?

  @@index([userId])
}

model UrlCorrection {
  id              Int      @id @default(autoincrement())
  sourceUrl       String   @db.VarChar(1000)
  ingredientIndex Int
  originalText    String   @db.VarChar(500)
  correctionType  String   @db.VarChar(20)
  correctionData  String?
  userId          Int
  createdAt       DateTime @default(now())

  @@unique([sourceUrl, ingredientIndex, userId])
  @@index([sourceUrl])
}
