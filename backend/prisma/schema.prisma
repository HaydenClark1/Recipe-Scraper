datasource db {
  provider = "sqlserver"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Food {
  fdcId       Int     @id
  description String  @db.NVarChar(500)
  dataType    String  @db.NVarChar(50)
  category    String? @db.NVarChar(100)
  calories    Float?
  protein     Float?
  fat         Float?
  carbs       Float?

  @@index([dataType])
}

model User {
  id           Int           @id @default(autoincrement())
  email        String        @unique @db.NVarChar(255)
  passwordHash String        @db.NVarChar(255)
  createdAt    DateTime      @default(now())
  savedRecipes SavedRecipe[]
}

model SavedRecipe {
  id           Int      @id @default(autoincrement())
  userId       Int
  user         User     @relation(fields: [userId], references: [id])
  title        String   @db.NVarChar(500)
  image        String?  @db.NVarChar(1000)
  ingredients  String   @db.NVarChar(Max)
  instructions String   @db.NVarChar(Max)
  servings     String?  @db.NVarChar(50)
  prepTime     String?  @db.NVarChar(100)
  totalTime    String?  @db.NVarChar(100)
  category     String?  @db.NVarChar(500)
  cuisine      String?  @db.NVarChar(500)
  sourceUrl    String?  @db.NVarChar(1000)
  createdAt    DateTime @default(now())
  overrides    IngredientOverride[]

  @@index([userId])
}

model IngredientOverride {
  id              Int         @id @default(autoincrement())
  savedRecipeId   Int
  savedRecipe     SavedRecipe @relation(fields: [savedRecipeId], references: [id], onDelete: Cascade)
  ingredientIndex Int
  type            String      @db.NVarChar(20)

  foodName        String?     @db.NVarChar(500)
  foodDescription String?     @db.NVarChar(1000)
  fdcId           Int?

  quantity        Float?
  unit            String?     @db.NVarChar(50)

  createdAt       DateTime    @default(now())

  @@index([savedRecipeId])
  @@unique([savedRecipeId, ingredientIndex, type])
}
